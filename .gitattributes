# Normalise to LF in the repo; check out native. Keeps mac and Windows from fighting.
* text=auto eol=lf

# Binary assets and golden fixtures must never be line-ending translated — a .ba1f is
# raw RGBA, and CRLF substitution would silently corrupt pixel data.
*.png binary
*.ico binary
*.icns binary
*.ba1f binary

pnpm-lock.yaml linguist-generated=true
apps/desktop/src-tauri/Cargo.lock linguist-generated=true
